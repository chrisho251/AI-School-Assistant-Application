# Copy to `.env` for local dev:  cp .env.example .env
#
# Base URL of the FastAPI backend. Leave EMPTY in dev — the client then calls
# "/api/*" and Vite proxies it to http://localhost:8000 (see vite.config.ts),
# avoiding CORS. Set it to the backend origin for a production build.
VITE_API_URL=

# One-click demo login shortcuts. These are the fixed UUIDs that
# `scripts/seed_demo.py` inserts, so they only work after you run the seeder
# against a backend in dev mode (no JWT secret set). Not secrets.
VITE_DEMO_ORG_ID=11111111-1111-1111-1111-111111111111
VITE_DEMO_TEACHER_ID=22222222-2222-2222-2222-222222222222
VITE_DEMO_STUDENT_ID=33333333-3333-3333-3333-333333333331
VITE_DEMO_CLASS_ID=44444444-4444-4444-4444-444444444444
