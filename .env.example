# ============ Supabase ============
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET= # leave it empty
SUPABASE_DB_URL=postgresql://postgres:[password]@db.xxx.supabase.co:5432/postgres

# ============ Local self-hosted services ============
TEI_EMBED_URL=http://localhost:8080
TEI_RERANK_URL=http://localhost:8081
# Per-request timeout (s) for TEI. CPU embedding is slow → keep high; lower on GPU.
TEI_TIMEOUT=120
# Embedding batch size (smaller = shorter per-request latency on CPU)
TEI_EMBED_BATCH_SIZE=16

# ============ LLM providers ============
GEMINI_API_KEY=
GROQ_API_KEY=
# OpenRouter optional
OPENROUTER_API_KEY=

# Default models (override per call qua LiteLLM)
ASAG_LLM_GENERATOR=gemini/gemini-2.5-flash
ASAG_LLM_JUDGE=groq/llama-3.3-70b-versatile

# ============ Storage ============
STORAGE_BACKEND=supabase
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=asag-sources
R2_ENDPOINT=

# ============ Observability ============
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ============ App ============
ASAG_ENV=development
ASAG_LOG_LEVEL=INFO
