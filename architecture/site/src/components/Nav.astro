---
const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";

// Feature flag — set to true to restore GitHub link in nav and footer.
const SHOW_GITHUB = false;
---

<nav class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 flex items-center justify-between h-14">

    <!-- Logo -->
    <a href={b} class="flex flex-col leading-tight group shrink-0">
      <span class="font-bold text-indigo-600 text-lg group-hover:text-indigo-700 transition">ASAG</span>
      <span class="text-xs text-slate-500 hidden sm:block">AI School Assistant &amp; Grader</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-5 text-sm font-medium text-slate-600">

      <li>
        <a href={b} class="hover:text-indigo-600 transition">Home</a>
      </li>

      <li>
        <a href={`${b}workflows`} class="hover:text-indigo-600 transition">Workflows</a>
      </li>

      <!-- Architecture dropdown -->
      <li class="relative">
        <details class="group">
          <summary class="list-none cursor-pointer select-none flex items-center gap-1 hover:text-indigo-600 transition py-1">
            Architecture
            <svg class="w-3 h-3 transition-transform group-open:rotate-180" viewBox="0 0 12 12" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="2,4 6,8 10,4"/>
            </svg>
          </summary>
          <div class="absolute left-0 top-full mt-1 w-52 bg-white shadow-xl rounded-xl p-2 flex flex-col gap-0.5 text-sm border border-slate-100 z-50">
            <a href={`${b}architecture/context`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Context (C4 L1)</a>
            <a href={`${b}architecture/containers`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Containers (C4 L2)</a>
            <hr class="border-slate-100 my-1" />
            <span class="px-3 py-1 text-xs font-semibold text-slate-400 uppercase tracking-wide">Pipelines</span>
            <a href={`${b}architecture/pipelines/ingestion`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Ingestion</a>
            <a href={`${b}architecture/pipelines/retrieval`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Retrieval</a>
            <a href={`${b}architecture/pipelines/assessment`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Assessment</a>
            <a href={`${b}architecture/pipelines/slide-generation`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Slide Generation</a>
          </div>
        </details>
      </li>

      <li>
        <a href={`${b}components`} class="hover:text-indigo-600 transition">Components</a>
      </li>

      <li>
        <a href={`${b}data-model`} class="hover:text-indigo-600 transition">Data Model</a>
      </li>

      <!-- Reference dropdown -->
      <li class="relative">
        <details class="group">
          <summary class="list-none cursor-pointer select-none flex items-center gap-1 hover:text-indigo-600 transition py-1">
            Reference
            <svg class="w-3 h-3 transition-transform group-open:rotate-180" viewBox="0 0 12 12" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="2,4 6,8 10,4"/>
            </svg>
          </summary>
          <div class="absolute left-0 top-full mt-1 w-56 bg-white shadow-xl rounded-xl p-2 flex flex-col gap-0.5 text-sm border border-slate-100 z-50">
            <a href={`${b}reference/glossary`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Glossary</a>
            <a href={`${b}reference/security-model`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Security Model</a>
            <a href={`${b}reference/non-functional-requirements`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Non-functional Req.</a>
            <a href={`${b}reference/operational-runbook`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Runbook</a>
          </div>
        </details>
      </li>

      {SHOW_GITHUB && (
        <li>
          <a
            href="https://github.com/hoduyhoang250196"
            class="hover:text-indigo-600 transition"
            target="_blank"
            rel="noopener noreferrer"
          >GitHub ↗</a>
        </li>
      )}
    </ul>

    <!-- Mobile hamburger (uses <details>, no JS required) -->
    <div class="md:hidden relative">
      <details>
        <summary class="list-none cursor-pointer p-2 rounded-lg hover:bg-slate-100 transition select-none">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-label="Menu">
            <rect y="3" width="20" height="2" rx="1"/>
            <rect y="9" width="20" height="2" rx="1"/>
            <rect y="15" width="20" height="2" rx="1"/>
          </svg>
        </summary>
        <div class="absolute right-0 top-full mt-2 w-56 bg-white shadow-xl rounded-xl p-3 flex flex-col gap-0.5 text-sm font-medium text-slate-600 border border-slate-100 max-h-[80vh] overflow-y-auto z-50">
          <a href={b} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Home</a>
          <a href={`${b}workflows`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Workflows</a>

          <div class="px-3 pt-3 pb-0.5 text-xs font-semibold text-slate-400 uppercase tracking-wide">Architecture</div>
          <a href={`${b}architecture/context`} class="pl-5 pr-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Context (C4 L1)</a>
          <a href={`${b}architecture/containers`} class="pl-5 pr-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Containers (C4 L2)</a>
          <a href={`${b}architecture/pipelines/ingestion`} class="pl-5 pr-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Ingestion</a>
          <a href={`${b}architecture/pipelines/retrieval`} class="pl-5 pr-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Retrieval</a>
          <a href={`${b}architecture/pipelines/assessment`} class="pl-5 pr-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Assessment</a>
          <a href={`${b}architecture/pipelines/slide-generation`} class="pl-5 pr-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Slide Generation</a>

          <a href={`${b}components`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Components</a>
          <a href={`${b}data-model`} class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Data Model</a>

          <div class="px-3 pt-3 pb-0.5 text-xs font-semibold text-slate-400 uppercase tracking-wide">Reference</div>
          <a href={`${b}reference/glossary`} class="pl-5 pr-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Glossary</a>
          <a href={`${b}reference/security-model`} class="pl-5 pr-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Security Model</a>
          <a href={`${b}reference/non-functional-requirements`} class="pl-5 pr-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Non-functional Req.</a>
          <a href={`${b}reference/operational-runbook`} class="pl-5 pr-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition">Runbook</a>

          {SHOW_GITHUB && (
            <a
              href="https://github.com/hoduyhoang250196"
              class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition"
              target="_blank"
              rel="noopener noreferrer"
            >GitHub ↗</a>
          )}
        </div>
      </details>
    </div>

  </div>
</nav>
