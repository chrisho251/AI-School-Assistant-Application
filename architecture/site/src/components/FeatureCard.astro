---
interface Props {
  icon: string;
  title: string;
  description: string;
  href: string;
}

const { icon, title, description, href } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col gap-3 bg-white rounded-2xl shadow hover:shadow-md transition p-6 border border-slate-100 hover:border-indigo-200"
>
  <span class="text-3xl">{icon}</span>
  <h3 class="text-base font-semibold text-slate-800 group-hover:text-indigo-700 transition">
    {title}
  </h3>
  <p class="text-sm text-slate-500 leading-relaxed">{description}</p>
</a>
