---
const items = [
  { dot: "bg-amber-100 border-amber-300",   label: "Users & UI" },
  { dot: "bg-sky-100 border-sky-300",        label: "Compute services" },
  { dot: "bg-rose-100 border-rose-300",      label: "AI models" },
  { dot: "bg-slate-100 border-slate-300",    label: "Data storage" },
] as const;
---

<div class="flex flex-wrap gap-3 pt-3 text-xs text-slate-600">
  {items.map(({ dot, label }) => (
    <span class="flex items-center gap-1.5">
      <span class={`inline-block w-3 h-3 rounded-sm border ${dot}`}></span>
      {label}
    </span>
  ))}
</div>
