---
interface Props {
  stages: string[];
}
const { stages } = Astro.props;
---

<div class="flex flex-wrap items-center gap-1.5 py-4">
  {stages.map((stage, i) => (
    <Fragment>
      <span class="bg-slate-100 border border-slate-300 rounded-full px-4 py-1.5 text-xs font-semibold text-slate-700 whitespace-nowrap">
        {stage}
      </span>
      {i < stages.length - 1 && (
        <span class="text-slate-400 text-sm select-none">›</span>
      )}
    </Fragment>
  ))}
</div>
