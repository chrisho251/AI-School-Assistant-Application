---
interface Props {
  title?: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<section class="bg-diagram-frame p-8 md:p-12 rounded-3xl my-8">
  <div class="bg-white rounded-2xl p-6 md:p-10 shadow-2xl">
    {title && <h3 class="text-xl font-semibold text-slate-800 mb-1">{title}</h3>}
    {subtitle && <p class="text-sm text-slate-500 mb-4">{subtitle}</p>}
    <div class="overflow-x-auto">
      <slot />
    </div>
  </div>
</section>
