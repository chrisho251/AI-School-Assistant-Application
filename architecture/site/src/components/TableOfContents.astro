---
/**
 * TableOfContents — renders an "On this page" sidebar/inline box.
 * Only shows when headings.length >= 3.
 *
 * Usage:
 *   <TableOfContents headings={[
 *     { id: "overview",         label: "Overview" },
 *     { id: "responsibilities", label: "Responsibilities" },
 *     { id: "interfaces",       label: "Interfaces", level: 2 },
 *   ]} />
 */

interface Heading {
  id: string;
  label: string;
  level?: 2 | 3;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const show = headings.length >= 3;
---

{show && (
  <aside
    aria-label="Table of contents"
    class="not-prose bg-slate-50 border border-slate-200 rounded-xl p-4 mb-8 text-sm"
  >
    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">On this page</p>
    <ol class="space-y-1.5">
      {headings.map((h) => (
        <li class={h.level === 3 ? "pl-4" : ""}>
          <a
            href={`#${h.id}`}
            class="text-slate-600 hover:text-indigo-600 transition leading-snug"
          >
            {h.label}
          </a>
        </li>
      ))}
    </ol>
  </aside>
)}
