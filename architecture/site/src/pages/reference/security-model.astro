---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PrevNext from "../../components/PrevNext.astro";
import DiagramFrame from "../../components/DiagramFrame.astro";
import Mermaid from "../../components/Mermaid.astro";

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";

// JWT authentication chain — sequenceDiagram
const jwtFlowCode = `sequenceDiagram
  autonumber
  participant Browser
  participant SupabaseAuth as Supabase Auth
  participant FastAPI
  participant Postgres

  Browser->>SupabaseAuth: signInWithPassword(email, password)
  SupabaseAuth-->>Browser: JWT { sub, email, org_id, role }

  Note over Browser,FastAPI: Every subsequent API call carries the JWT

  Browser->>FastAPI: GET /api/v1/notebooks<br/>Authorization: Bearer &lt;JWT&gt;
  FastAPI->>SupabaseAuth: verify_jwt(token, SUPABASE_JWT_SECRET)
  SupabaseAuth-->>FastAPI: claims { sub, org_id, role }

  FastAPI->>Postgres: SET LOCAL app.user_id = sub<br/>SET LOCAL app.org_id = org_id
  FastAPI->>Postgres: SELECT * FROM notebooks
  Postgres-->>FastAPI: rows filtered by RLS policy<br/>(only caller's org_id visible)
  FastAPI-->>Browser: JSON { notebooks: [...] }`;
---

<BaseLayout
  title="Security Model"
  description="Authentication flow, RLS chain, and multi-layer security model for ASAG."
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <Breadcrumbs />
    <h1 class="text-3xl font-bold text-slate-800 mb-2">Security Model</h1>
    <p class="text-slate-500 mb-8 leading-relaxed max-w-2xl">
      ASAG enforces data isolation through five independent layers. A failure in any one
      layer is contained by the others. The diagram below traces a single authenticated
      request from browser to database row.
    </p>

    <!-- JWT authentication flow ─────────────────────────────────── -->
    <h2 class="text-lg font-semibold text-slate-700 mb-3">JWT authentication chain</h2>

    <DiagramFrame subtitle="Browser → Supabase Auth → FastAPI → Postgres RLS — 8 steps">
      <Mermaid code={jwtFlowCode} />
    </DiagramFrame>

    <!-- Five-layer model ──────────────────────────────────────────── -->
    <h2 class="text-lg font-semibold text-slate-700 mt-10 mb-4">Five-layer security model</h2>

    <div class="space-y-3">

      <div class="flex gap-4 border border-slate-200 rounded-xl p-4 bg-white">
        <div class="shrink-0 w-8 h-8 rounded-full bg-red-100 text-red-700 text-sm font-bold flex items-center justify-center">1</div>
        <div>
          <p class="font-semibold text-slate-800">
            Identity —
            <a href={`${b}components/supabase-auth`} class="text-indigo-600 hover:underline text-sm font-normal ml-1">Supabase Auth</a>
          </p>
          <p class="text-sm text-slate-500 mt-0.5">
            Email/password or Google OAuth. On success, Supabase Auth issues a signed JWT
            (HS256) containing <code class="bg-slate-100 px-1 rounded text-xs">sub</code>,
            <code class="bg-slate-100 px-1 rounded text-xs">org_id</code>, and
            <code class="bg-slate-100 px-1 rounded text-xs">role</code> claims injected via a
            Postgres hook. Token TTL: 1 hour; refresh token TTL: 7 days.
          </p>
        </div>
      </div>

      <div class="flex gap-4 border border-slate-200 rounded-xl p-4 bg-white">
        <div class="shrink-0 w-8 h-8 rounded-full bg-orange-100 text-orange-700 text-sm font-bold flex items-center justify-center">2</div>
        <div>
          <p class="font-semibold text-slate-800">
            Authentication —
            <a href={`${b}components/fastapi`} class="text-indigo-600 hover:underline text-sm font-normal ml-1">FastAPI JWT middleware</a>
          </p>
          <p class="text-sm text-slate-500 mt-0.5">
            Every request goes through <code class="bg-slate-100 px-1 rounded text-xs">verify_jwt()</code>
            in FastAPI middleware before any route handler runs. An invalid, expired, or missing
            token returns HTTP 401. The verified claims are passed into the route context.
          </p>
        </div>
      </div>

      <div class="flex gap-4 border border-slate-200 rounded-xl p-4 bg-white">
        <div class="shrink-0 w-8 h-8 rounded-full bg-amber-100 text-amber-700 text-sm font-bold flex items-center justify-center">3</div>
        <div>
          <p class="font-semibold text-slate-800">
            Authorisation —
            <a href={`${b}components/fastapi`} class="text-indigo-600 hover:underline text-sm font-normal ml-1">FastAPI RBAC</a>
          </p>
          <p class="text-sm text-slate-500 mt-0.5">
            Route handlers check the <code class="bg-slate-100 px-1 rounded text-xs">role</code>
            claim. Only users with <code class="bg-slate-100 px-1 rounded text-xs">teacher</code>
            or <code class="bg-slate-100 px-1 rounded text-xs">admin</code> roles can create
            notebooks, upload sources, or publish quizzes. Students are blocked at the handler
            before any database query executes.
          </p>
        </div>
      </div>

      <div class="flex gap-4 border border-slate-200 rounded-xl p-4 bg-white">
        <div class="shrink-0 w-8 h-8 rounded-full bg-green-100 text-green-700 text-sm font-bold flex items-center justify-center">4</div>
        <div>
          <p class="font-semibold text-slate-800">
            Data isolation —
            <a href={`${b}components/postgres-rls`} class="text-indigo-600 hover:underline text-sm font-normal ml-1">Postgres Row-Level Security</a>
          </p>
          <p class="text-sm text-slate-500 mt-0.5">
            FastAPI calls <code class="bg-slate-100 px-1 rounded text-xs">SET LOCAL app.user_id</code>
            and <code class="bg-slate-100 px-1 rounded text-xs">SET LOCAL app.org_id</code> on
            the connection before every query, using the JWT claims. All eight tenant-scoped tables
            have RLS enabled; policies filter rows to the caller's org. A bug in application code
            that omits a <code class="bg-slate-100 px-1 rounded text-xs">WHERE org_id = …</code>
            clause is blocked by the database layer.
          </p>
        </div>
      </div>

      <div class="flex gap-4 border border-slate-200 rounded-xl p-4 bg-white">
        <div class="shrink-0 w-8 h-8 rounded-full bg-blue-100 text-blue-700 text-sm font-bold flex items-center justify-center">5</div>
        <div>
          <p class="font-semibold text-slate-800">
            Storage access —
            <a href={`${b}components/supabase-storage`} class="text-indigo-600 hover:underline text-sm font-normal ml-1">Signed URLs</a>
          </p>
          <p class="text-sm text-slate-500 mt-0.5">
            Source files and generated artefacts are stored in private buckets. Access requires
            either a valid Supabase JWT (checked by Supabase's bucket policies) or a
            time-limited signed URL scoped to a specific file path. Signed URLs expire after
            1 hour and cannot be used to access other files in the bucket.
          </p>
        </div>
      </div>
    </div>

    <!-- Threat table ─────────────────────────────────────────────── -->
    <h2 class="text-lg font-semibold text-slate-700 mt-10 mb-4">Top threat mitigations</h2>

    <div class="border border-slate-200 rounded-xl overflow-hidden text-sm">
      <table class="w-full">
        <thead class="bg-slate-50 text-slate-500 uppercase text-xs tracking-wide">
          <tr>
            <th class="px-4 py-3 text-left">Threat</th>
            <th class="px-4 py-3 text-left">Mitigation</th>
            <th class="px-4 py-3 text-left">Layer</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <tr>
            <td class="px-4 py-3 font-medium text-slate-700">Cross-tenant data read</td>
            <td class="px-4 py-3 text-slate-500">RLS policy on every table; <code class="bg-slate-100 px-1 rounded text-xs">org_id</code> check enforced at DB level</td>
            <td class="px-4 py-3 text-slate-400">Layer 4</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium text-slate-700">JWT replay / forgery</td>
            <td class="px-4 py-3 text-slate-500">Short 1-hour TTL; HS256 signature with <code class="bg-slate-100 px-1 rounded text-xs">SUPABASE_JWT_SECRET</code></td>
            <td class="px-4 py-3 text-slate-400">Layer 2</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium text-slate-700">Prompt injection via uploaded docs</td>
            <td class="px-4 py-3 text-slate-500">Chunk text is <em>data</em> to the LLM prompt, not instructions; system prompt separates roles explicitly</td>
            <td class="px-4 py-3 text-slate-400">Application</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium text-slate-700">Student code execution escape</td>
            <td class="px-4 py-3 text-slate-500">Code runs in E2B microVM (or Docker container); ASAG host filesystem is not accessible</td>
            <td class="px-4 py-3 text-slate-400">Infrastructure</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium text-slate-700">File upload abuse (large/malicious)</td>
            <td class="px-4 py-3 text-slate-500">25 MB limit enforced in FastAPI before storage write; Docling parses content, not executes it</td>
            <td class="px-4 py-3 text-slate-400">Layer 3</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Related links ────────────────────────────────────────────── -->
    <div class="mt-8 flex flex-wrap gap-3 text-sm">
      <a href={`${b}components/supabase-auth`}
         class="inline-flex items-center gap-1 border border-slate-200 rounded-lg px-4 py-2 text-slate-600 hover:text-indigo-600 hover:border-indigo-200 bg-white transition">
        Supabase Auth →
      </a>
      <a href={`${b}components/postgres-rls`}
         class="inline-flex items-center gap-1 border border-slate-200 rounded-lg px-4 py-2 text-slate-600 hover:text-indigo-600 hover:border-indigo-200 bg-white transition">
        Postgres RLS →
      </a>
      <a href={`${b}components/fastapi`}
         class="inline-flex items-center gap-1 border border-slate-200 rounded-lg px-4 py-2 text-slate-600 hover:text-indigo-600 hover:border-indigo-200 bg-white transition">
        FastAPI middleware →
      </a>
      <a href={`${b}components/e2b-sandbox`}
         class="inline-flex items-center gap-1 border border-slate-200 rounded-lg px-4 py-2 text-slate-600 hover:text-indigo-600 hover:border-indigo-200 bg-white transition">
        E2B Code Sandbox →
      </a>
    </div>

    <PrevNext
      prev={{ label: "Glossary", href: `${b}reference/glossary` }}
      next={{ label: "Non-functional Req.", href: `${b}reference/non-functional-requirements` }}
    />
  </div>
</BaseLayout>
