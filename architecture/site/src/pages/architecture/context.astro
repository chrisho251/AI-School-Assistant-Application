---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PrevNext from "../../components/PrevNext.astro";
import DiagramFrame from "../../components/DiagramFrame.astro";

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
---

<BaseLayout
  title="Context — C4 Level 1"
  description="C4 Level 1 System Context diagram for ASAG — the system boundary, user types, and external SaaS dependencies."
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <Breadcrumbs />
    <h1 class="text-3xl font-bold text-slate-800 mb-2">Context — C4 Level 1</h1>
    <p class="text-slate-500 mb-8 leading-relaxed max-w-2xl">
      The highest-level view of ASAG: the system boundary, who interacts with it, and which
      external services it depends on. Based on the{" "}
      <a href="https://c4model.com/" class="text-indigo-600 hover:underline" target="_blank" rel="noopener noreferrer">C4 model</a>.
      Every external SaaS is labelled with its current-tier constraint.
    </p>

    <DiagramFrame title="ASAG — System Context" subtitle="C4 Level 1 · users, ASAG system boundary, external dependencies">
      <!--
        SVG viewport: 900 × 620
        Layout:
          Row 0 (y=40):   Teacher (left)     Student (right)
          Row 1 (y=200):  [ASAG system boundary — large rounded rect spanning centre]
          Row 2 (y=420):  Supabase  Gemini  Groq  E2B  Inngest  (external SaaS, below boundary)
      -->
      <svg
        viewBox="0 0 900 640"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full max-w-4xl mx-auto font-sans text-sm"
        aria-label="C4 Level 1 System Context diagram for ASAG"
      >
        <defs>
          <!-- Arrow marker for relationship lines -->
          <marker id="ctx-arrow" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="#475569" />
          </marker>
          <!-- Dashed arrow for planned services -->
          <marker id="ctx-arrow-dashed" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="#94a3b8" />
          </marker>
        </defs>

        <!-- ─── ACTORS (top row) ─── -->
        <!-- Teacher -->
        <g>
          <!-- Person icon -->
          <circle cx="145" cy="58" r="18" fill="#fef9c3" stroke="#92400e" stroke-width="1.5"/>
          <line x1="145" y1="76" x2="145" y2="112" stroke="#92400e" stroke-width="1.5"/>
          <line x1="115" y1="92" x2="175" y2="92" stroke="#92400e" stroke-width="1.5"/>
          <line x1="145" y1="112" x2="120" y2="135" stroke="#92400e" stroke-width="1.5"/>
          <line x1="145" y1="112" x2="170" y2="135" stroke="#92400e" stroke-width="1.5"/>
          <text x="145" y="155" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Teacher</text>
          <text x="145" y="170" text-anchor="middle" font-size="11" fill="#64748b">[Person]</text>
        </g>

        <!-- Student -->
        <g>
          <circle cx="755" cy="58" r="18" fill="#dbeafe" stroke="#1e40af" stroke-width="1.5"/>
          <line x1="755" y1="76" x2="755" y2="112" stroke="#1e40af" stroke-width="1.5"/>
          <line x1="725" y1="92" x2="785" y2="92" stroke="#1e40af" stroke-width="1.5"/>
          <line x1="755" y1="112" x2="730" y2="135" stroke="#1e40af" stroke-width="1.5"/>
          <line x1="755" y1="112" x2="780" y2="135" stroke="#1e40af" stroke-width="1.5"/>
          <text x="755" y="155" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Student</text>
          <text x="755" y="170" text-anchor="middle" font-size="11" fill="#64748b">[Person]</text>
        </g>

        <!-- ─── ASAG SYSTEM BOUNDARY ─── -->
        <rect x="260" y="40" width="380" height="190" rx="12" ry="12"
              fill="#f0fdf4" stroke="#16a34a" stroke-width="2" stroke-dasharray="6,3"/>
        <text x="450" y="64" text-anchor="middle" font-size="11" fill="#15803d" font-weight="600" letter-spacing="0.05em">SYSTEM BOUNDARY</text>

        <!-- ASAG central box -->
        <rect x="295" y="75" width="310" height="130" rx="10" ry="10"
              fill="#ecfdf5" stroke="#16a34a" stroke-width="2"/>
        <text x="450" y="106" text-anchor="middle" font-size="15" font-weight="700" fill="#064e3b">ASAG</text>
        <text x="450" y="124" text-anchor="middle" font-size="11" fill="#065f46">AI School Assistant &amp; Grader</text>
        <line x1="310" y1="130" x2="590" y2="130" stroke="#a7f3d0" stroke-width="1"/>
        <text x="450" y="148" text-anchor="middle" font-size="10" fill="#047857">Streamlit UI · FastAPI · RAG Engine</text>
        <text x="450" y="163" text-anchor="middle" font-size="10" fill="#047857">Assessment Engine · Studio Engine</text>
        <text x="450" y="178" text-anchor="middle" font-size="10" fill="#047857">TEI Embedding · TEI Reranker</text>

        <!-- ─── ACTOR → ASAG ARROWS ─── -->
        <!-- Teacher → ASAG -->
        <line x1="220" y1="120" x2="293" y2="130"
              stroke="#475569" stroke-width="1.5" marker-end="url(#ctx-arrow)"/>
        <rect x="185" y="95" width="110" height="28" rx="4" fill="white" opacity="0.9"/>
        <text x="240" y="106" text-anchor="middle" font-size="9" fill="#475569">Uploads materials,</text>
        <text x="240" y="117" text-anchor="middle" font-size="9" fill="#475569">configures quizzes</text>

        <!-- Student → ASAG -->
        <line x1="680" y1="120" x2="607" y2="130"
              stroke="#475569" stroke-width="1.5" marker-end="url(#ctx-arrow)"/>
        <rect x="605" y="95" width="110" height="28" rx="4" fill="white" opacity="0.9"/>
        <text x="660" y="106" text-anchor="middle" font-size="9" fill="#475569">Takes quizzes, asks</text>
        <text x="660" y="117" text-anchor="middle" font-size="9" fill="#475569">Q&amp;A, gets slides</text>

        <!-- ─── EXTERNAL SAAS (bottom row) ─── -->

        <!-- Supabase Cloud -->
        <rect x="30" y="370" width="150" height="80" rx="8" ry="8"
              fill="#fef3c7" stroke="#d97706" stroke-width="1.5"/>
        <text x="105" y="398" text-anchor="middle" font-size="12" font-weight="600" fill="#92400e">Supabase Cloud</text>
        <text x="105" y="413" text-anchor="middle" font-size="10" fill="#b45309">[External SaaS]</text>
        <text x="105" y="428" text-anchor="middle" font-size="9" fill="#92400e">Auth · Postgres · Storage</text>
        <text x="105" y="441" text-anchor="middle" font-size="9" fill="#92400e">Free tier: 500 MB DB / 1 GB</text>

        <!-- Google Gemini -->
        <rect x="210" y="370" width="150" height="80" rx="8" ry="8"
              fill="#f0f9ff" stroke="#0284c7" stroke-width="1.5"/>
        <text x="285" y="398" text-anchor="middle" font-size="12" font-weight="600" fill="#0c4a6e">Google Gemini</text>
        <text x="285" y="413" text-anchor="middle" font-size="10" fill="#0369a1">[External SaaS]</text>
        <text x="285" y="428" text-anchor="middle" font-size="9" fill="#0369a1">2.5 Flash · 1M ctx</text>
        <text x="285" y="441" text-anchor="middle" font-size="9" fill="#0369a1">Free: 1 500 req/day</text>

        <!-- Groq -->
        <rect x="390" y="370" width="120" height="80" rx="8" ry="8"
              fill="#fdf4ff" stroke="#a21caf" stroke-width="1.5"/>
        <text x="450" y="398" text-anchor="middle" font-size="12" font-weight="600" fill="#701a75">Groq API</text>
        <text x="450" y="413" text-anchor="middle" font-size="10" fill="#a21caf">[External SaaS]</text>
        <text x="450" y="428" text-anchor="middle" font-size="9" fill="#a21caf">Llama 3.3 70B</text>
        <text x="450" y="441" text-anchor="middle" font-size="9" fill="#a21caf">LLM-as-Judge</text>

        <!-- E2B Cloud (planned) -->
        <rect x="540" y="370" width="130" height="80" rx="8" ry="8"
              fill="#f8fafc" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4,2"/>
        <text x="605" y="395" text-anchor="middle" font-size="12" font-weight="600" fill="#475569">E2B Cloud</text>
        <text x="605" y="410" text-anchor="middle" font-size="10" fill="#64748b">[External SaaS]</text>
        <text x="605" y="425" text-anchor="middle" font-size="9" fill="#64748b">Code sandbox</text>
        <text x="605" y="440" text-anchor="middle" font-size="9" fill="#94a3b8">planned</text>
        <rect x="575" y="446" width="60" height="16" rx="8" fill="#e2e8f0"/>
        <text x="605" y="458" text-anchor="middle" font-size="9" fill="#64748b">planned</text>

        <!-- Inngest (planned) -->
        <rect x="700" y="370" width="130" height="80" rx="8" ry="8"
              fill="#f8fafc" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4,2"/>
        <text x="765" y="395" text-anchor="middle" font-size="12" font-weight="600" fill="#475569">Inngest</text>
        <text x="765" y="410" text-anchor="middle" font-size="10" fill="#64748b">[External SaaS]</text>
        <text x="765" y="425" text-anchor="middle" font-size="9" fill="#64748b">Background jobs</text>
        <text x="765" y="440" text-anchor="middle" font-size="9" fill="#94a3b8">planned</text>
        <rect x="735" y="446" width="60" height="16" rx="8" fill="#e2e8f0"/>
        <text x="765" y="458" text-anchor="middle" font-size="9" fill="#64748b">planned</text>

        <!-- ─── ASAG → SAAS ARROWS ─── -->
        <!-- ASAG → Supabase -->
        <line x1="360" y1="205" x2="150" y2="368"
              stroke="#475569" stroke-width="1.5" marker-end="url(#ctx-arrow)"/>
        <rect x="185" y="278" width="130" height="28" rx="4" fill="white" opacity="0.9"/>
        <text x="250" y="290" text-anchor="middle" font-size="9" fill="#475569">Auth, DB reads/writes,</text>
        <text x="250" y="301" text-anchor="middle" font-size="9" fill="#475569">file storage</text>

        <!-- ASAG → Gemini -->
        <line x1="400" y1="205" x2="305" y2="368"
              stroke="#475569" stroke-width="1.5" marker-end="url(#ctx-arrow)"/>
        <rect x="290" y="278" width="120" height="28" rx="4" fill="white" opacity="0.9"/>
        <text x="350" y="290" text-anchor="middle" font-size="9" fill="#475569">Quiz generation,</text>
        <text x="350" y="301" text-anchor="middle" font-size="9" fill="#475569">slide outlines</text>

        <!-- ASAG → Groq -->
        <line x1="450" y1="205" x2="450" y2="368"
              stroke="#475569" stroke-width="1.5" marker-end="url(#ctx-arrow)"/>
        <rect x="415" y="270" width="70" height="24" rx="4" fill="white" opacity="0.9"/>
        <text x="450" y="281" text-anchor="middle" font-size="9" fill="#475569">LLM-as-Judge</text>
        <text x="450" y="292" text-anchor="middle" font-size="9" fill="#475569">grading</text>

        <!-- ASAG → E2B (dashed) -->
        <line x1="510" y1="205" x2="580" y2="368"
              stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,3" marker-end="url(#ctx-arrow-dashed)"/>
        <rect x="515" y="268" width="100" height="24" rx="4" fill="white" opacity="0.9"/>
        <text x="565" y="279" text-anchor="middle" font-size="9" fill="#94a3b8">Execute student</text>
        <text x="565" y="290" text-anchor="middle" font-size="9" fill="#94a3b8">code (sandbox)</text>

        <!-- ASAG → Inngest (dashed) -->
        <line x1="555" y1="200" x2="720" y2="368"
              stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,3" marker-end="url(#ctx-arrow-dashed)"/>
        <rect x="628" y="268" width="100" height="24" rx="4" fill="white" opacity="0.9"/>
        <text x="678" y="279" text-anchor="middle" font-size="9" fill="#94a3b8">Enqueue ingestion</text>
        <text x="678" y="290" text-anchor="middle" font-size="9" fill="#94a3b8">&amp; grading jobs</text>

        <!-- ─── LEGEND ─── -->
        <rect x="30" y="490" width="220" height="90" rx="8" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
        <text x="45" y="510" font-size="10" font-weight="600" fill="#475569">Legend</text>
        <line x1="45" y1="525" x2="85" y2="525" stroke="#475569" stroke-width="1.5" marker-end="url(#ctx-arrow)"/>
        <text x="95" y="529" font-size="9" fill="#475569">In-use dependency</text>
        <line x1="45" y1="545" x2="85" y2="545" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,3" marker-end="url(#ctx-arrow-dashed)"/>
        <text x="95" y="549" font-size="9" fill="#64748b">Planned dependency</text>
        <rect x="45" y="558" width="14" height="14" rx="3" fill="#f0fdf4" stroke="#16a34a" stroke-width="1.5" stroke-dasharray="4,2"/>
        <text x="67" y="569" font-size="9" fill="#475569">ASAG system boundary</text>
      </svg>
    </DiagramFrame>

    <!-- Key decisions callout -->
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm">
        <p class="font-semibold text-slate-700 mb-1">Why one system boundary?</p>
        <p class="text-slate-500">
          TEI (embedding + reranker) runs as Docker containers on the same host as FastAPI.
          They are internal infrastructure, not external SaaS — so they live inside the boundary.
        </p>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm">
        <p class="font-semibold text-slate-700 mb-1">Anti-bias rule</p>
        <p class="text-slate-500">
          Gemini generates quizzes; Groq judges answers. Different vendors prevent
          self-preference score inflation (+5–15% on subjective rubrics).
        </p>
      </div>
    </div>

    <PrevNext
      prev={{ label: "Architecture overview", href: `${b}architecture` }}
      next={{ label: "Containers (C4 L2)", href: `${b}architecture/containers` }}
    />
  </div>
</BaseLayout>
