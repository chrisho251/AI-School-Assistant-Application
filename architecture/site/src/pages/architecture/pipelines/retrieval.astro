---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PrevNext from "../../../components/PrevNext.astro";

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
---

<BaseLayout
  title="Retrieval Pipeline"
  description="Hybrid dense + sparse search, RRF fusion, and cross-encoder reranking in ASAG."
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <Breadcrumbs />
    <h1 class="text-3xl font-bold text-slate-800 mb-2">Retrieval Pipeline</h1>
    <p class="text-slate-500 mb-4">
      Combines dense vector search (BGE-M3 → pgvector ANN) with sparse BM25/FTS search, merges
      results with Reciprocal Rank Fusion, then applies a cross-encoder reranker for final ordering.
    </p>
    <div class="bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 mb-6 text-sm text-slate-500 flex items-center gap-2">
      Detailed step-by-step diagram available at
      <a href={`${b}diagrams/retrieval`} class="text-indigo-600 hover:underline font-medium">Retrieval Pipeline diagram →</a>
    </div>
    <PrevNext
      prev={{ label: "Ingestion Pipeline", href: `${b}architecture/pipelines/ingestion` }}
      next={{ label: "Assessment Pipeline", href: `${b}architecture/pipelines/assessment` }}
    />
  </div>
</BaseLayout>
