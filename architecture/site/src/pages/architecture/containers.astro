---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PrevNext from "../../components/PrevNext.astro";
import DiagramFrame from "../../components/DiagramFrame.astro";

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
---

<BaseLayout
  title="Containers — C4 Level 2"
  description="C4 Level 2 Container diagram for ASAG — internal services, technology choices, and communication paths."
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <Breadcrumbs />
    <h1 class="text-3xl font-bold text-slate-800 mb-2">Containers — C4 Level 2</h1>
    <p class="text-slate-500 mb-8 leading-relaxed max-w-2xl">
      Zooms into the ASAG system boundary to show each deployable unit, its technology, and
      how containers communicate. Clickable nodes link to their component detail page.
    </p>

    <DiagramFrame title="ASAG — Container Diagram" subtitle="C4 Level 2 · click any highlighted node for details">
      <!--
        Viewport: 960 × 700
        Row 0 (y≈30):  Browser [external]
        Row 1 (y≈130): Streamlit UI | FastAPI
        Row 2 (y≈290): Ingestion Worker | RAG Engine | Assessment Engine | Studio Engine
        Row 3 (y≈440): TEI Embed | TEI Reranker | Postgres+pgvector | Supabase Storage | Supabase Auth | Langfuse
      -->
      <svg
        viewBox="0 0 960 700"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full max-w-5xl mx-auto font-sans"
        aria-label="C4 Level 2 Container diagram for ASAG"
      >
        <defs>
          <marker id="cnt-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L7,3 z" fill="#475569"/>
          </marker>
          <marker id="cnt-arrow-obs" markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L7,3 z" fill="#f97316"/>
          </marker>
        </defs>

        <!-- ══ BROWSER (external) ══ -->
        <rect x="360" y="12" width="240" height="48" rx="8"
              fill="#f1f5f9" stroke="#475569" stroke-width="1.5"/>
        <text x="480" y="33" text-anchor="middle" font-size="12" font-weight="700" fill="#1e293b">Browser</text>
        <text x="480" y="49" text-anchor="middle" font-size="10" fill="#64748b">[External · Teacher &amp; Student]</text>

        <!-- ══ SYSTEM BOUNDARY ══ -->
        <rect x="10" y="80" width="940" height="610" rx="14"
              fill="none" stroke="#16a34a" stroke-width="1.5" stroke-dasharray="6,3"/>
        <text x="26" y="100" font-size="10" font-weight="600" fill="#15803d" letter-spacing="0.04em">ASAG SYSTEM BOUNDARY</text>

        <!-- ── ROW 1: Streamlit UI ─── -->
        <!-- Clickable -->
        <a href={`${b}components/streamlit`} target="_self">
          <rect x="30" y="110" width="230" height="110" rx="10"
                fill="#f0fdfa" stroke="#0d9488" stroke-width="2"
                class="hover:stroke-indigo-500 transition-colors cursor-pointer"/>
          <text x="145" y="138" text-anchor="middle" font-size="13" font-weight="700" fill="#134e4a">Streamlit UI</text>
          <text x="145" y="154" text-anchor="middle" font-size="10" fill="#0f766e">[Container · Python]</text>
          <line x1="50" y1="161" x2="240" y2="161" stroke="#99f6e4" stroke-width="1"/>
          <text x="145" y="175" text-anchor="middle" font-size="9" fill="#0f766e">Teacher + student web interface</text>
          <text x="145" y="188" text-anchor="middle" font-size="9" fill="#0f766e">Port 8501</text>
          <text x="145" y="210" text-anchor="middle" font-size="9" fill="#14b8a6" font-weight="600">→ click for details</text>
        </a>

        <!-- FastAPI -->
        <a href={`${b}components/fastapi`} target="_self">
          <rect x="290" y="110" width="260" height="110" rx="10"
                fill="#eff6ff" stroke="#3b82f6" stroke-width="2"
                class="hover:stroke-indigo-500 transition-colors cursor-pointer"/>
          <text x="420" y="138" text-anchor="middle" font-size="13" font-weight="700" fill="#1e3a8a">FastAPI</text>
          <text x="420" y="154" text-anchor="middle" font-size="10" fill="#1d4ed8">[Container · Python · port 8000]</text>
          <line x1="310" y1="161" x2="530" y2="161" stroke="#bfdbfe" stroke-width="1"/>
          <text x="420" y="175" text-anchor="middle" font-size="9" fill="#1d4ed8">JWT verify · RLS context setter</text>
          <text x="420" y="188" text-anchor="middle" font-size="9" fill="#1d4ed8">Rate limiting · API routing</text>
          <text x="420" y="210" text-anchor="middle" font-size="9" fill="#3b82f6" font-weight="600">→ click for details</text>
        </a>

        <!-- Supabase Auth (top-right, separate from infra row for layout) -->
        <a href={`${b}components/supabase-auth`} target="_self">
          <rect x="590" y="110" width="190" height="110" rx="10"
                fill="#fff1f2" stroke="#f43f5e" stroke-width="2"
                class="hover:stroke-indigo-500 transition-colors cursor-pointer"/>
          <text x="685" y="138" text-anchor="middle" font-size="12" font-weight="700" fill="#881337">Supabase Auth</text>
          <text x="685" y="153" text-anchor="middle" font-size="10" fill="#be123c">[External SaaS]</text>
          <line x1="605" y1="160" x2="765" y2="160" stroke="#fecdd3" stroke-width="1"/>
          <text x="685" y="174" text-anchor="middle" font-size="9" fill="#be123c">JWT issuance</text>
          <text x="685" y="187" text-anchor="middle" font-size="9" fill="#be123c">Custom claims hook</text>
          <text x="685" y="210" text-anchor="middle" font-size="9" fill="#f43f5e" font-weight="600">→ click for details</text>
        </a>

        <!-- Langfuse (top-right corner) -->
        <a href={`${b}components/langfuse`} target="_self">
          <rect x="800" y="110" width="140" height="110" rx="10"
                fill="#fff7ed" stroke="#f97316" stroke-width="2"
                class="hover:stroke-indigo-500 transition-colors cursor-pointer"/>
          <text x="870" y="136" text-anchor="middle" font-size="12" font-weight="700" fill="#7c2d12">Langfuse</text>
          <text x="870" y="151" text-anchor="middle" font-size="10" fill="#c2410c">[Self-hosted]</text>
          <line x1="815" y1="158" x2="925" y2="158" stroke="#fed7aa" stroke-width="1"/>
          <text x="870" y="172" text-anchor="middle" font-size="9" fill="#c2410c">LLM trace storage</text>
          <text x="870" y="185" text-anchor="middle" font-size="9" fill="#c2410c">Observability UI</text>
          <text x="870" y="210" text-anchor="middle" font-size="9" fill="#f97316" font-weight="600">→ click for details</text>
        </a>

        <!-- ── ROW 2: Internal Engines ── -->
        <!-- Ingestion Worker (no component link — process group) -->
        <rect x="30" y="270" width="205" height="100" rx="8"
              fill="#fafafa" stroke="#94a3b8" stroke-width="1.5"/>
        <text x="133" y="295" text-anchor="middle" font-size="12" font-weight="600" fill="#334155">Ingestion Worker</text>
        <text x="133" y="310" text-anchor="middle" font-size="10" fill="#64748b">[Process group]</text>
        <line x1="48" y1="316" x2="217" y2="316" stroke="#e2e8f0" stroke-width="1"/>
        <text x="133" y="330" text-anchor="middle" font-size="9" fill="#64748b">Docling parse → chunk</text>
        <text x="133" y="343" text-anchor="middle" font-size="9" fill="#64748b">BGE-M3 embed → pgvector</text>
        <text x="133" y="358" text-anchor="middle" font-size="9" fill="#64748b">Inngest-triggered</text>

        <!-- RAG Engine -->
        <rect x="255" y="270" width="180" height="100" rx="8"
              fill="#fafafa" stroke="#94a3b8" stroke-width="1.5"/>
        <text x="345" y="295" text-anchor="middle" font-size="12" font-weight="600" fill="#334155">RAG Engine</text>
        <text x="345" y="310" text-anchor="middle" font-size="10" fill="#64748b">[Process group]</text>
        <line x1="268" y1="316" x2="422" y2="316" stroke="#e2e8f0" stroke-width="1"/>
        <text x="345" y="330" text-anchor="middle" font-size="9" fill="#64748b">Hybrid retrieval + RRF</text>
        <text x="345" y="343" text-anchor="middle" font-size="9" fill="#64748b">Reranker + Q&amp;A chain</text>

        <!-- Assessment Engine -->
        <rect x="455" y="270" width="190" height="100" rx="8"
              fill="#fafafa" stroke="#94a3b8" stroke-width="1.5"/>
        <text x="550" y="295" text-anchor="middle" font-size="12" font-weight="600" fill="#334155">Assessment Engine</text>
        <text x="550" y="310" text-anchor="middle" font-size="10" fill="#64748b">[Process group]</text>
        <line x1="468" y1="316" x2="632" y2="316" stroke="#e2e8f0" stroke-width="1"/>
        <text x="550" y="330" text-anchor="middle" font-size="9" fill="#64748b">Quiz generation</text>
        <text x="550" y="343" text-anchor="middle" font-size="9" fill="#64748b">LLM-as-Judge grading</text>

        <!-- Studio Engine -->
        <rect x="665" y="270" width="175" height="100" rx="8"
              fill="#fafafa" stroke="#94a3b8" stroke-width="1.5"/>
        <text x="753" y="295" text-anchor="middle" font-size="12" font-weight="600" fill="#334155">Studio Engine</text>
        <text x="753" y="310" text-anchor="middle" font-size="10" fill="#64748b">[Process group]</text>
        <line x1="678" y1="316" x2="828" y2="316" stroke="#e2e8f0" stroke-width="1"/>
        <text x="753" y="330" text-anchor="middle" font-size="9" fill="#64748b">Slide outline (Gemini)</text>
        <text x="753" y="343" text-anchor="middle" font-size="9" fill="#64748b">Marp CLI → .pptx/.html</text>

        <!-- ── ROW 3: Infrastructure ── -->
        <!-- TEI Embed -->
        <a href={`${b}components/tei`} target="_self">
          <rect x="30" y="425" width="140" height="95" rx="8"
                fill="#f0f9ff" stroke="#0284c7" stroke-width="2"
                class="hover:stroke-indigo-500 transition-colors cursor-pointer"/>
          <text x="100" y="449" text-anchor="middle" font-size="11" font-weight="700" fill="#0c4a6e">TEI · Embed</text>
          <text x="100" y="463" text-anchor="middle" font-size="10" fill="#0369a1">[Docker · :8080]</text>
          <line x1="44" y1="470" x2="156" y2="470" stroke="#bae6fd" stroke-width="1"/>
          <text x="100" y="483" text-anchor="middle" font-size="9" fill="#0369a1">BGE-M3</text>
          <text x="100" y="496" text-anchor="middle" font-size="9" fill="#0369a1">dense + sparse</text>
          <text x="100" y="511" text-anchor="middle" font-size="9" fill="#0284c7" font-weight="600">→ details</text>
        </a>

        <!-- TEI Reranker -->
        <a href={`${b}components/tei`} target="_self">
          <rect x="185" y="425" width="140" height="95" rx="8"
                fill="#f0f9ff" stroke="#0284c7" stroke-width="2"
                class="hover:stroke-indigo-500 transition-colors cursor-pointer"/>
          <text x="255" y="449" text-anchor="middle" font-size="11" font-weight="700" fill="#0c4a6e">TEI · Reranker</text>
          <text x="255" y="463" text-anchor="middle" font-size="10" fill="#0369a1">[Docker · :8081]</text>
          <line x1="198" y1="470" x2="312" y2="470" stroke="#bae6fd" stroke-width="1"/>
          <text x="255" y="483" text-anchor="middle" font-size="9" fill="#0369a1">bge-reranker-v2-m3</text>
          <text x="255" y="496" text-anchor="middle" font-size="9" fill="#0369a1">cross-encoder</text>
          <text x="255" y="511" text-anchor="middle" font-size="9" fill="#0284c7" font-weight="600">→ details</text>
        </a>

        <!-- Postgres + pgvector -->
        <a href={`${b}components/pgvector`} target="_self">
          <rect x="340" y="425" width="170" height="95" rx="8"
                fill="#fefce8" stroke="#ca8a04" stroke-width="2"
                class="hover:stroke-indigo-500 transition-colors cursor-pointer"/>
          <text x="425" y="449" text-anchor="middle" font-size="11" font-weight="700" fill="#713f12">Postgres + pgvector</text>
          <text x="425" y="463" text-anchor="middle" font-size="10" fill="#92400e">[Supabase Cloud]</text>
          <line x1="354" y1="470" x2="496" y2="470" stroke="#fde68a" stroke-width="1"/>
          <text x="425" y="483" text-anchor="middle" font-size="9" fill="#92400e">Relational data + vectors</text>
          <text x="425" y="496" text-anchor="middle" font-size="9" fill="#92400e">RLS enforced · 500 MB</text>
          <text x="425" y="511" text-anchor="middle" font-size="9" fill="#ca8a04" font-weight="600">→ details</text>
        </a>

        <!-- Supabase Storage -->
        <a href={`${b}components/supabase-storage`} target="_self">
          <rect x="525" y="425" width="150" height="95" rx="8"
                fill="#fef3c7" stroke="#d97706" stroke-width="2"
                class="hover:stroke-indigo-500 transition-colors cursor-pointer"/>
          <text x="600" y="449" text-anchor="middle" font-size="11" font-weight="700" fill="#78350f">Supabase Storage</text>
          <text x="600" y="463" text-anchor="middle" font-size="10" fill="#92400e">[S3-compatible]</text>
          <line x1="539" y1="470" x2="661" y2="470" stroke="#fde68a" stroke-width="1"/>
          <text x="600" y="483" text-anchor="middle" font-size="9" fill="#92400e">sources + artifacts</text>
          <text x="600" y="496" text-anchor="middle" font-size="9" fill="#92400e">Signed URLs · 1 GB</text>
          <text x="600" y="511" text-anchor="middle" font-size="9" fill="#d97706" font-weight="600">→ details</text>
        </a>

        <!-- (Supabase Auth shown in row 1; skip repeat here) -->

        <!-- Langfuse trace note in infra row -->
        <rect x="690" y="425" width="250" height="95" rx="8"
              fill="#f8fafc" stroke="#e2e8f0" stroke-width="1.5"/>
        <text x="815" y="449" text-anchor="middle" font-size="11" font-weight="600" fill="#475569">Observability</text>
        <text x="815" y="463" text-anchor="middle" font-size="10" fill="#64748b">All services send async traces</text>
        <line x1="703" y1="470" x2="927" y2="470" stroke="#e2e8f0" stroke-width="1"/>
        <text x="815" y="483" text-anchor="middle" font-size="9" fill="#64748b">→ Langfuse (self-hosted)</text>
        <text x="815" y="496" text-anchor="middle" font-size="9" fill="#64748b">Prompt versions · cost tracking</text>
        <text x="815" y="511" text-anchor="middle" font-size="9" fill="#f97316" font-weight="600">Langfuse ↗ (see row 1)</text>

        <!-- ══ ARROWS ══ -->

        <!-- Browser → Streamlit UI -->
        <line x1="430" y1="60" x2="210" y2="110"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>
        <text x="295" y="80" text-anchor="middle" font-size="9" fill="#475569">HTTPS</text>

        <!-- Browser → Streamlit (also direct - show SSE response back, but simplify) -->

        <!-- Streamlit → FastAPI -->
        <line x1="260" y1="165" x2="290" y2="165"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>
        <text x="275" y="157" text-anchor="middle" font-size="9" fill="#475569">REST/SSE</text>

        <!-- FastAPI → Auth -->
        <line x1="550" y1="155" x2="590" y2="155"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>
        <text x="570" y="147" text-anchor="middle" font-size="9" fill="#475569">JWT verify</text>

        <!-- FastAPI → Ingestion Worker -->
        <line x1="345" y1="220" x2="133" y2="270"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>
        <text x="215" y="243" text-anchor="middle" font-size="8" fill="#64748b">Inngest event</text>

        <!-- FastAPI → RAG Engine -->
        <line x1="380" y1="220" x2="345" y2="270"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>

        <!-- FastAPI → Assessment Engine -->
        <line x1="450" y1="220" x2="530" y2="270"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>

        <!-- FastAPI → Studio Engine -->
        <line x1="490" y1="220" x2="720" y2="270"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>

        <!-- Ingestion → TEI Embed -->
        <line x1="100" y1="370" x2="100" y2="425"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>
        <text x="107" y="402" font-size="8" fill="#64748b">HTTP /embed</text>

        <!-- Ingestion → Postgres -->
        <line x1="155" y1="370" x2="390" y2="425"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>
        <text x="270" y="388" text-anchor="middle" font-size="8" fill="#64748b">INSERT chunks</text>

        <!-- Ingestion → Storage (READ source file) -->
        <line x1="175" y1="355" x2="540" y2="425"
              stroke="#64748b" stroke-width="1" stroke-dasharray="3,2" marker-end="url(#cnt-arrow)"/>

        <!-- RAG → TEI Embed -->
        <line x1="285" y1="370" x2="160" y2="425"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>

        <!-- RAG → TEI Reranker -->
        <line x1="305" y1="370" x2="240" y2="425"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>

        <!-- RAG → Postgres -->
        <line x1="345" y1="370" x2="380" y2="425"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>

        <!-- Assessment → Postgres -->
        <line x1="510" y1="370" x2="460" y2="425"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>

        <!-- Studio → Storage -->
        <line x1="730" y1="370" x2="640" y2="425"
              stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>
        <text x="700" y="393" text-anchor="middle" font-size="8" fill="#64748b">PUT .pptx/.html</text>

        <!-- All → Langfuse (show as one representative arrow from FastAPI) -->
        <line x1="790" y1="165" x2="845" y2="220"
              stroke="#f97316" stroke-width="1" stroke-dasharray="3,2" marker-end="url(#cnt-arrow-obs)"/>
        <text x="840" y="195" font-size="8" fill="#f97316">traces (async)</text>

        <!-- ── LEGEND ── -->
        <rect x="30" y="560" width="300" height="72" rx="8" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
        <text x="48" y="578" font-size="10" font-weight="600" fill="#475569">Legend</text>
        <line x1="48" y1="592" x2="88" y2="592" stroke="#475569" stroke-width="1.5" marker-end="url(#cnt-arrow)"/>
        <text x="98" y="596" font-size="9" fill="#475569">Synchronous call</text>
        <line x1="48" y1="610" x2="88" y2="610" stroke="#64748b" stroke-width="1" stroke-dasharray="3,2" marker-end="url(#cnt-arrow)"/>
        <text x="98" y="614" font-size="9" fill="#64748b">Async / background</text>
        <line x1="48" y1="624" x2="88" y2="624" stroke="#f97316" stroke-width="1" stroke-dasharray="3,2" marker-end="url(#cnt-arrow-obs)"/>
        <text x="98" y="628" font-size="9" fill="#f97316">Observability trace</text>
      </svg>
    </DiagramFrame>

    <!-- Notes -->
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <p class="font-semibold text-slate-700 mb-1">Self-hosted containers</p>
        <p class="text-slate-500">TEI Embed + TEI Reranker run as Docker containers alongside FastAPI on the same host. No external API calls for embedding or reranking.</p>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <p class="font-semibold text-slate-700 mb-1">Process groups</p>
        <p class="text-slate-500">Ingestion, RAG, Assessment, and Studio are logical groupings of Python modules inside FastAPI — not separate processes in the MVP build.</p>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <p class="font-semibold text-slate-700 mb-1">RLS on every DB call</p>
        <p class="text-slate-500">FastAPI sets <code class="bg-slate-200 px-1 rounded text-xs">app.user_id</code> and <code class="bg-slate-200 px-1 rounded text-xs">app.org_id</code> on each connection before any query, activating Postgres RLS policies.</p>
      </div>
    </div>

    <PrevNext
      prev={{ label: "Context (C4 L1)", href: `${b}architecture/context` }}
      next={{ label: "Ingestion Pipeline", href: `${b}architecture/pipelines/ingestion` }}
    />
  </div>
</BaseLayout>
