---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";

type DiagramCard = {
  title: string;
  subtitle: string;
  href: string;
};

const c4: DiagramCard[] = [
  {
    title: "Context (C4 L1)",
    subtitle: "System boundary, actors, and external SaaS dependencies",
    href: `${b}architecture/context`,
  },
  {
    title: "Containers (C4 L2)",
    subtitle: "12 deployable containers with communication paths",
    href: `${b}architecture/containers`,
  },
  {
    title: "High-Level Map",
    subtitle: "All 6 layers — users, API, services, AI, data, observability",
    href: `${b}diagrams/high-level`,
  },
];

const pipelines: DiagramCard[] = [
  {
    title: "Ingestion",
    subtitle: "File upload → parse → chunk → embed → pgvector index",
    href: `${b}diagrams/ingestion`,
  },
  {
    title: "Retrieval",
    subtitle: "Hybrid search (HNSW + FTS) + RRF + cross-encoder rerank",
    href: `${b}diagrams/retrieval`,
  },
  {
    title: "Assessment",
    subtitle: "Quiz generation and LLM-as-Judge grading",
    href: `${b}diagrams/assessment`,
  },
  {
    title: "Slide Generation",
    subtitle: "Retrieval → Gemini outline → Marp CLI → .pptx/.html",
    href: `${b}diagrams/slide-generation`,
  },
];

const dataFlows: DiagramCard[] = [
  {
    title: "Workflows",
    subtitle: "Pipeline orchestration map and 3 lifecycle state machines",
    href: `${b}workflows`,
  },
  {
    title: "Data Model",
    subtitle: "Full 15-table ERD with column reference",
    href: `${b}data-model`,
  },
  {
    title: "Security Model",
    subtitle: "JWT chain, 5-layer security model, threat mitigations",
    href: `${b}reference/security-model`,
  },
];
---

<BaseLayout
  title="Architecture Diagrams"
  description="All ASAG architecture diagrams — C4 context and containers, pipeline deep-dives, ERD, security flow, and lifecycle state machines."
>
  <!-- Header -->
  <div class="bg-diagram-frame py-12 px-6 border-b border-slate-200 text-center">
    <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-2">Architecture Diagrams</h1>
    <p class="text-slate-500 text-sm max-w-xl mx-auto">
      Ten views into ASAG — from the C4 context boundary down to pipeline internals,
      entity relationships, and the security chain. Click any node on a diagram to open
      its component page.
    </p>
  </div>

  <div class="max-w-5xl mx-auto px-4 py-12 space-y-14">

    <!-- Section 1: C4 Architecture -->
    <section>
      <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">
        C4 Architecture
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {c4.map((d) => (
          <a
            href={d.href}
            class="group flex flex-col gap-2 bg-white border border-slate-200 rounded-xl p-5 hover:shadow-md hover:border-indigo-200 transition"
          >
            <p class="font-semibold text-slate-800 group-hover:text-indigo-700 transition">
              {d.title}
            </p>
            <p class="text-sm text-slate-500 leading-relaxed flex-1">{d.subtitle}</p>
            <span class="text-sm font-medium text-indigo-600 group-hover:text-indigo-800 transition mt-1">
              Open →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Section 2: Pipeline diagrams -->
    <section>
      <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">
        Pipeline diagrams
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {pipelines.map((d) => (
          <a
            href={d.href}
            class="group flex flex-col gap-2 bg-white border border-slate-200 rounded-xl p-5 hover:shadow-md hover:border-indigo-200 transition"
          >
            <p class="font-semibold text-slate-800 group-hover:text-indigo-700 transition">
              {d.title}
            </p>
            <p class="text-sm text-slate-500 leading-relaxed flex-1">{d.subtitle}</p>
            <span class="text-sm font-medium text-indigo-600 group-hover:text-indigo-800 transition mt-1">
              Open →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Section 3: Data & flows -->
    <section>
      <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">
        Data &amp; flows
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {dataFlows.map((d) => (
          <a
            href={d.href}
            class="group flex flex-col gap-2 bg-white border border-slate-200 rounded-xl p-5 hover:shadow-md hover:border-indigo-200 transition"
          >
            <p class="font-semibold text-slate-800 group-hover:text-indigo-700 transition">
              {d.title}
            </p>
            <p class="text-sm text-slate-500 leading-relaxed flex-1">{d.subtitle}</p>
            <span class="text-sm font-medium text-indigo-600 group-hover:text-indigo-800 transition mt-1">
              Open →
            </span>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
