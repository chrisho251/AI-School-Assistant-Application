---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DiagramFrame from "../../components/DiagramFrame.astro";
import Mermaid from "../../components/Mermaid.astro";
import { getEntry, getCollection, render } from "astro:content";

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";

const entry = await getEntry("architecture", "slide-generation");
const { Content } = await render(entry!);

const components = await getCollection("components");
const related = components.filter((c) => c.data.usedInPipeline.includes("slides"));

// 4-step flow from content: broad retrieval → outline → Marp markdown → CLI export → Storage
const diagram = `flowchart LR
  Request["👩‍🏫 Teacher\\nrequest slide deck"]
  Retrieve["Hybrid + rerank\\ntop-30 chunks"]
  Outline["Gemini Flash\\noutline JSON\\n(titles + bullets + source_chunk_ids)"]
  Jinja["Jinja template\\n→ Marp markdown"]
  MarpCLI["marp-cli\\nexport"]
  PPTX["📊 .pptx"]
  HTML["🌐 .html"]
  Storage["Supabase Storage\\nartifacts row"]

  Request --> Retrieve
  Retrieve --> Outline
  Outline --> Jinja
  Jinja --> MarpCLI
  MarpCLI --> PPTX
  MarpCLI --> HTML
  PPTX --> Storage
  HTML --> Storage

  click Outline href "${b}components/gemini-flash" "Open Gemini Flash page"
  click MarpCLI href "${b}components/marp" "Open Marp page"
  click Storage href "${b}components/supabase" "Open Supabase page"
  click Retrieve href "${b}diagrams/retrieval" "Open Retrieval pipeline"`;
---

<BaseLayout
  title="Slide Generation Pipeline"
  description="How ASAG turns a notebook into a .pptx deck — retrieval, Gemini outline, Marp rendering."
>
  <div class="bg-diagram-frame py-12 px-6 border-b border-slate-200 text-center">
    <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-2">Slide Generation Pipeline</h1>
    <p class="text-slate-500 text-sm max-w-xl mx-auto">
      Notebook in, <code class="bg-slate-100 text-slate-700 rounded px-1">.pptx</code> out.
      Same retrieval pipeline as Q&amp;A; the only difference is the prompt and the renderer.
    </p>
  </div>

  <section class="max-w-6xl mx-auto px-4 py-10">
    <DiagramFrame
      title="Slide Generation — 4 Steps"
      subtitle="Broad retrieval (top-30) → Gemini outline JSON → Jinja/Marp markdown → marp-cli export to .pptx + .html."
    >
      <Mermaid code={diagram} />
    </DiagramFrame>
  </section>

  <div class="md-content max-w-3xl mx-auto px-4 py-8">
    <Content />
  </div>

  {related.length > 0 && (
    <section class="max-w-3xl mx-auto px-4 pb-16">
      <h2 class="text-sm font-bold text-slate-500 uppercase tracking-widest mb-4">
        Components in this pipeline
      </h2>
      <div class="flex flex-wrap gap-3">
        {related.map((c) => (
          <a
            href={`${b}components/${c.id}`}
            class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2 text-sm font-medium text-slate-700 hover:text-indigo-600 hover:border-indigo-200 shadow-sm hover:shadow-md transition"
          >
            {c.data.icon && <span class="text-base">{c.data.icon}</span>}
            {c.data.title}
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
