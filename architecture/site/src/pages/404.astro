---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
---

<BaseLayout title="404 — Page not found">
  <div class="max-w-2xl mx-auto px-4 py-24">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3">404</p>
    <h1 class="text-3xl font-bold text-slate-800 mb-3">Page not found</h1>
    <p class="text-slate-500 text-base mb-10">
      The page at this URL doesn't exist. Use the navigation above or the links
      below to find what you're looking for.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a
        href={`${b}`}
        class="group flex flex-col gap-1 border border-slate-200 rounded-xl p-4 bg-white hover:border-indigo-200 hover:shadow-sm transition"
      >
        <span class="font-semibold text-slate-700 group-hover:text-indigo-600 transition">Home</span>
        <span class="text-xs text-slate-400">Back to the landing page</span>
        <span class="text-xs text-indigo-500 mt-1">Go →</span>
      </a>

      <a
        href={`${b}components`}
        class="group flex flex-col gap-1 border border-slate-200 rounded-xl p-4 bg-white hover:border-indigo-200 hover:shadow-sm transition"
      >
        <span class="font-semibold text-slate-700 group-hover:text-indigo-600 transition">Components</span>
        <span class="text-xs text-slate-400">All 23 documented components</span>
        <span class="text-xs text-indigo-500 mt-1">Go →</span>
      </a>

      <a
        href={`${b}architecture/context`}
        class="group flex flex-col gap-1 border border-slate-200 rounded-xl p-4 bg-white hover:border-indigo-200 hover:shadow-sm transition"
      >
        <span class="font-semibold text-slate-700 group-hover:text-indigo-600 transition">Architecture</span>
        <span class="text-xs text-slate-400">C4 diagrams and pipeline views</span>
        <span class="text-xs text-indigo-500 mt-1">Go →</span>
      </a>
    </div>
  </div>
</BaseLayout>
